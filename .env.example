# Interview Copilot does NOT read API keys from environment variables or .env files.
# Add your keys in the app: Settings → AI providers. They are encrypted with the
# macOS Keychain (Electron safeStorage) and never written to disk in plain text.
#
# The variables below are optional and only used for development and tests.

# Use a separate data directory (keeps tests away from your real profile and keys).
# COPILOT_USER_DATA_DIR=/tmp/interview-copilot-dev

# Speed up the scripted demo interview (1 = real time).
# COPILOT_DEMO_SPEED=1

# macOS code signing / notarization for `npm run dist:mac` (electron-builder):
# CSC_LINK=/path/to/DeveloperIDApplication.p12
# CSC_KEY_PASSWORD=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
